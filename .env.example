# Telegram bot tokeni (@BotFather dan)
BOT_TOKEN=your_telegram_bot_token

# Bosh admin Telegram ID'lari (vergul bilan) — /admin panel ruxsatini olish uchun
# Misol: OWNER_IDS=12345678,98765432
OWNER_IDS=

# PostgreSQL — docker-compose bilan ishlatilsa, shu paroldan foydalanadi
DB_PASSWORD=change_me_strong_password

# Dev/lokal ishga tushirish uchun (docker emas)
DATABASE_URL=postgresql://mafia:change_me_strong_password@localhost:5432/mafiabot

NODE_ENV=production
LOG_LEVEL=info
